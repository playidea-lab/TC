# PostgreSQL (with pgvector extension)
DATABASE_URL=postgresql://commons:changeme@localhost:5432/commons

# Google Gemini (Embedding + Reranker)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_RERANKER_MODEL=gemini-2.5-flash

# CQ JWT verification (CQ가 발행한 토큰을 TC가 검증)
CQ_JWT_PUBLIC_KEY_PATH=/secrets/cq_jwt_pub.pem
CQ_JWT_ISSUER=cq.pilab.kr
CQ_JWT_AUDIENCE=the-commons

# Retirement worker
RETIREMENT_REAL_THRESHOLD=3
RETIREMENT_CHECK_INTERVAL_SEC=300

# Serializer
TEMPLATE_VERSION=v1

# 매치메이커
RETRIEVE_TOP_K=20
RECOMMEND_TOP_N=5

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=json

# Production proxy 뒤에서 True (K8s Ingress 등). dev엔 False.
TRUST_FORWARDED_FOR=false
